#!/usr/bin/env bash
# oai-iperf - iperf3 menu (taskbar launcher target). Installed to /usr/local/bin by ./install.sh.
# UE-tunnel tests talk to iperf3 inside the OAI core's oai-ext-dn container through oaitun_ue1.
set -uo pipefail   # no -e: a failed test must not close the menu

EXT_DN=192.168.70.135
B=$'\033[1m'; R=$'\033[31m'; N=$'\033[0m'
LAST_HOST=""

docker_cmd() { if docker info >/dev/null 2>&1; then docker "$@"; else sudo docker "$@"; fi; }
ue_ip() { ip -br -4 addr show oaitun_ue1 2>/dev/null | awk '{split($3,a,"/"); print a[1]}'; }
ask() { local v; read -rp "$1 [$2]: " v; printf '%s' "${v:-$2}"; }

ue_test() {   # ue_test dl|ul
    local ip; ip="$(ue_ip)"
    [ -n "$ip" ] || { echo "${R}no oaitun_ue1${N} - start core + gNB + nrUE from the OAI launcher first"; return; }
    docker_cmd exec -d oai-ext-dn iperf3 -s -1 >/dev/null 2>&1 || { echo "${R}oai-ext-dn container not running${N}"; return; }
    sleep 1
    local t; t="$(ask "Seconds" 10)"
    if [ "$1" = dl ]; then echo "${B}Downlink: ext-dn -> UE ($ip)${N}"; iperf3 -c "$EXT_DN" -B "$ip" -R -t "$t"
    else echo "${B}Uplink: UE ($ip) -> ext-dn${N}"; iperf3 -c "$EXT_DN" -B "$ip" -t "$t"; fi
}

client() {
    local host t dir udp bw args=()
    host="$(ask "Server host/IP" "${LAST_HOST:-127.0.0.1}")"; LAST_HOST="$host"
    t="$(ask "Seconds" 10)"
    dir="$(ask "Direction: u=upload (to server), d=download (-R), b=both (--bidir)" u)"
    udp="$(ask "UDP? y/n" n)"
    case "$dir" in d) args+=(-R) ;; b) args+=(--bidir) ;; esac
    if [ "$udp" = y ]; then bw="$(ask "UDP target bitrate (e.g. 50M)" 50M)"; args+=(-u -b "$bw"); fi
    iperf3 -c "$host" -t "$t" "${args[@]}"
}

server() {
    local port; port="$(ask "Port" 5201)"
    echo "Listening on port $port (Ctrl+C returns to the menu). Addresses here:"
    ip -br -4 addr | awk '$1!="lo"{print "  "$1"  "$3}'
    trap 'echo' INT; iperf3 -s -p "$port"; trap - INT
}

while true; do
    cat <<EOF

${B}iperf3${N}   UE tunnel: $( [ -n "$(ue_ip)" ] && echo "up ($(ue_ip))" || echo "down")
  1) UE downlink test (core ext-dn -> UE)
  2) UE uplink test   (UE -> core ext-dn)
  3) Client to any host
  4) Server on this PC
  q) Quit
EOF
    read -rp "> " c || exit 0
    case "$c" in
        1) ue_test dl ;; 2) ue_test ul ;; 3) client ;; 4) server ;;
        q|Q) exit 0 ;; *) echo "?" ;;
    esac
done
